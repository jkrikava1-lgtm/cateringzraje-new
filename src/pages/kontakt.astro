---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const title = 'Kontakt';
const description = 'Kontaktní informace Catering z ráje. Zavolejte nebo napište — rádi zodpovíme vaše dotazy a domluvíme se na cateringu.';
---

<Layout title={title} description={description}>

  <section class="pt-20 lg:pt-24 bg-stone-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Kontakt</h1>
      <p class="text-stone-200 text-lg">Ozvěte se nám — rádi odpovíme na vaše dotazy a domluvíme se na spolupráci.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12">

        <!-- Kontaktní údaje -->
        <div>
          <h2 class="text-2xl font-extrabold text-stone-900 mb-8">Jak nás najdete</h2>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-stone-900 mb-0.5">Adresa</div>
                <div class="text-stone-600">{site.address}</div>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-stone-900 mb-0.5">Telefon</div>
                <a href={site.phone_href} class="text-brand-600 hover:underline text-lg font-medium">{site.phone}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 text-brand-600 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-stone-900 mb-0.5">E-mail</div>
                <a href={`mailto:${site.email}`} class="text-brand-600 hover:underline">{site.email}</a>
              </div>
            </div>
          </div>

          <!-- Mapa placeholder -->
          <div class="mt-8 rounded-2xl overflow-hidden border border-stone-200 h-64 bg-stone-100">
            <iframe
              src="https://maps.google.com/maps?q=N%C3%A1m%C4%9Bst%C3%AD+m%C3%ADru+5%2C+507+43+Sobotka&t=&z=17&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa – Catering z ráje, Sobotka"
            ></iframe>
          </div>
        </div>

        <!-- Poptávkový formulář -->
        <div>
          <h2 class="text-2xl font-extrabold text-stone-900 mb-2">Napište nám</h2>
          <p class="text-stone-500 mb-8">Pro rychlé vyřízení použijte <a href="/poptavka/" class="text-brand-500 hover:underline">poptávkový formulář</a> nebo nám napište přímo.</p>
          <div class="bg-stone-50 rounded-2xl p-8 border border-stone-100">
            <p class="text-stone-600 text-sm leading-relaxed">
              Nejrychlejší odpověď dostanete telefonicky na <a href={site.phone_href} class="text-brand-600 font-semibold">{site.phone}</a> nebo e-mailem na <a href={`mailto:${site.email}`} class="text-brand-600 font-semibold">{site.email}</a>.
            </p>
            <div class="mt-6">
              <a href="/poptavka/" class="inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-semibold rounded-xl transition-colors">
                Přejít na poptávkový formulář
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
