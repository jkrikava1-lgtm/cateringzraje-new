---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const title = 'Nezávazná poptávka';
const description = 'Pošlete poptávku na catering. Řekněte nám o vaší akci a my vám připravíme nabídku na míru.';
---

<Layout title={title} description={description}>

  <section class="pt-20 lg:pt-24 relative overflow-hidden bg-stone-900 text-white">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/galerie/foto-7.webp"
        alt=""
        class="w-full h-full object-cover object-center opacity-75 hero-bg-image"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-stone-900/95 via-stone-900/75 to-stone-900/45 sm:via-stone-900/60 sm:to-stone-900/10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-stone-900/40 via-transparent to-stone-900/50"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Nezávazná poptávka</h1>
      <p class="text-stone-200 text-lg max-w-2xl">Řekněte nám o vaší akci a my vám obratem připravíme nabídku na míru. Bez závazku, zdarma.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <div id="form-success" class="hidden mb-8 bg-green-50 border border-green-200 text-green-800 rounded-2xl px-6 py-5">
        <div class="font-bold mb-1">Poptávka odeslána!</div>
        <p class="text-sm">Děkujeme, ozveme se vám co nejdříve.</p>
      </div>

      <form id="poptavka-form" class="space-y-6" novalidate>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="jmeno" class="block text-sm font-semibold text-stone-700 mb-1.5">Jméno a příjmení *</label>
            <input
              type="text" id="jmeno" name="jmeno" required
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              placeholder="Jan Novák"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-stone-700 mb-1.5">E-mail *</label>
            <input
              type="email" id="email" name="email" required
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              placeholder="jan@example.cz"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="telefon" class="block text-sm font-semibold text-stone-700 mb-1.5">Telefon</label>
            <input
              type="tel" id="telefon" name="telefon"
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              placeholder="+420 777 000 000"
            />
          </div>
          <div>
            <label for="typ-akce" class="block text-sm font-semibold text-stone-700 mb-1.5">Typ akce *</label>
            <select
              id="typ-akce" name="typ-akce" required
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition bg-white"
            >
              <option value="" disabled selected>Vyberte typ akce</option>
              <option value="firemni-akce">Firemní akce</option>
              <option value="rodinne-oslavy">Rodinná oslava</option>
              <option value="svatebni-hostina">Svatební hostina</option>
              <option value="stankovy-prodej">Stánkový prodej / open-air</option>
              <option value="jine">Jiné</option>
            </select>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="datum" class="block text-sm font-semibold text-stone-700 mb-1.5">Přibližné datum akce</label>
            <input
              type="date" id="datum" name="datum"
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
            />
          </div>
          <div>
            <label for="pocet-hostu" class="block text-sm font-semibold text-stone-700 mb-1.5">Počet hostů</label>
            <input
              type="number" id="pocet-hostu" name="pocet-hostu" min="1"
              class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              placeholder="Přibližný počet"
            />
          </div>
        </div>

        <div>
          <label for="zprava" class="block text-sm font-semibold text-stone-700 mb-1.5">Popis akce a vaše přání</label>
          <textarea
            id="zprava" name="zprava" rows="5"
            class="w-full px-4 py-3 border border-stone-200 rounded-xl text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-none"
            placeholder="Popište svou akci — místo konání, čas, požadavky na jídlo, nebo cokoliv, co se nám hodí vědět..."
          ></textarea>
        </div>

        <div id="form-error" class="hidden text-red-600 text-sm bg-red-50 border border-red-200 rounded-xl px-4 py-3"></div>

        <button
          type="submit" id="submit-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl transition-colors shadow-lg text-lg disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="submit-label">Odeslat poptávku</span>
          <svg id="submit-spinner" class="hidden w-5 h-5 ml-2 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
          </svg>
        </button>

        <p class="text-xs text-stone-400">* Povinná pole. Vaše údaje používáme výhradně pro zpracování poptávky.</p>
      </form>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('poptavka-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const label = document.getElementById('submit-label')!;
  const spinner = document.getElementById('submit-spinner')!;
  const errorBox = document.getElementById('form-error')!;
  const success = document.getElementById('form-success')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    btn.disabled = true;
    label.textContent = 'Odesílám...';
    spinner.classList.remove('hidden');

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/poptavka', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || 'Chyba serveru');
      form.classList.add('hidden');
      success.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err: any) {
      errorBox.textContent = err.message || 'Nastala chyba. Zkuste to prosím znovu nebo nás kontaktujte telefonicky.';
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      label.textContent = 'Odeslat poptávku';
      spinner.classList.add('hidden');
    }
  });
</script>
