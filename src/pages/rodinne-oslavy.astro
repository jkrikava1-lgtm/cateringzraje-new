---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const title = 'Rodinné oslavy';
const description = 'Catering pro rodinné oslavy, narozeniny a výročí. Čerstvě připravené jídlo přímo pro vaše hosty, abyste se mohli naplno věnovat svým blízkým.';
---

<Layout title={title} description={description}>

  <section class="pt-20 lg:pt-24 bg-stone-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 lg:py-28">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-500/20 border border-brand-400/30 text-brand-300 text-xs font-semibold rounded-full mb-5 uppercase tracking-wider">
          Rodinné oslavy
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-5 leading-tight">
          Rodinná oslava <span class="text-brand-400">nezapomenutelná</span>
        </h1>
        <p class="text-stone-200 text-lg leading-relaxed mb-8">
          Plánujete rodinnou oslavu, narozeniny nebo jinou významnou událost? Rádi se postaráme o veškerý catering, abyste si mohli svůj zvláštní den užít bez starostí.
        </p>
        <a href="/poptavka/" class="inline-flex items-center px-7 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl transition-colors shadow-lg">
          Nezávazná poptávka
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-extrabold text-stone-900 mb-6">Oslava podle vašich přání</h2>
          <p class="text-stone-600 leading-relaxed mb-5">
            Nabízíme bohatý výběr pokrmů formou švédských stolů, které potěší chuťové buňky všech vašich hostů. Všechna jídla jsou připravována čerstvě přímo před vašimi hosty a pravidelně doplňována, aby byla neustále čerstvá a teplá.
          </p>
          <p class="text-stone-600 leading-relaxed mb-8">
            Ať už pořádáte menší rodinné setkání nebo velkou oslavu, náš catering přizpůsobíme vašim potřebám a postaráme se, aby vše proběhlo hladce a podle vašich představ.
          </p>
          <ul class="space-y-3">
            {[
              'Narozeniny, výročí, křtiny i jiné oslavy',
              'Bohaté švédské stoly s čerstvým jídlem',
              'Obsluha přímo na místě oslavy',
              'Flexibilní menu pro všechny věkové skupiny',
              'Menší i větší akce — bez problémů',
            ].map(item => (
              <li class="flex items-center gap-3 text-stone-700">
                <svg class="w-5 h-5 text-brand-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <img
            src="/images/rodinne-oslavy.jpg"
            alt="Rodinné oslavy – catering"
            class="w-full rounded-2xl shadow-xl aspect-[4/3] object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-stone-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 mb-4">Chystáte rodinnou slavnost?</h2>
      <p class="text-stone-600 mb-8 max-w-lg mx-auto">Ozvěte se nám a domluvíme catering přímo na míru vaší oslavy.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/poptavka/" class="inline-flex items-center justify-center px-7 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl transition-colors shadow">
          Odeslat poptávku
        </a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-flex items-center justify-center px-7 py-3.5 bg-white hover:bg-stone-50 border border-stone-200 text-stone-800 font-semibold rounded-xl transition-colors">
          {site.phone}
        </a>
      </div>
    </div>
  </section>

</Layout>
